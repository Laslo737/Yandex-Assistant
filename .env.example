PORT=3000
APP_NAME=yandex-360-ai-assistant
APP_VERSION=0.1.0
NODE_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:3000
ENABLE_DEBUG_COMMANDS=false

ENABLE_YANDEX_MESSENGER=true
YANDEX_MESSENGER_KEY=
YANDEX_WEBHOOK_SECRET=
YANDEX_API_BASE_URL=https://botapi.messenger.yandex.net
YANDEX_AUTH_HEADER=Authorization
YANDEX_AUTH_SCHEME=OAuth

ENABLE_YANDEX_TRACKER=false
YANDEX_TRACKER_API_BASE_URL=https://api.tracker.yandex.net
YANDEX_TRACKER_WEB_BASE_URL=https://tracker.yandex.ru
YANDEX_TRACKER_OAUTH_TOKEN=
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_CLOUD_ORG_ID=

LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=Yandex 360 AI Assistant
