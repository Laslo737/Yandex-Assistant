# Server
PORT=3002
NODE_ENV=production
APP_NAME=yandex-360-ai-assistant
APP_VERSION=0.1.0
# Public HTTPS URL served by nginx; no trailing slash.
APP_PUBLIC_BASE_URL=https://assistant.example.com
ENABLE_DEBUG_COMMANDS=false
# Persistent metric redirects. Ubuntu: /var/lib/yassistant/short-links.sqlite
SHORT_LINKS_DB_PATH=./data/short-links.sqlite

# Admin analytics (off by default). Ubuntu: /var/lib/yassistant/analytics.sqlite
ENABLE_ADMIN=false
ANALYTICS_DB_PATH=./data/analytics.sqlite
ANALYTICS_RETENTION_DAYS=90
ADMIN_USERNAME=admin
# Minimum 5 characters; a random password >=20 characters is recommended in production.
# Never commit it. HTTPS is required in production.
ADMIN_PASSWORD=

# Yandex Messenger (required when ENABLE_YANDEX_MESSENGER=true)
ENABLE_YANDEX_MESSENGER=false
YANDEX_MESSENGER_KEY=
YANDEX_WEBHOOK_SECRET=
# For Messenger login name@company.tld -> Tracker login name; set to your organization domain.
YANDEX_MESSENGER_LOGIN_DOMAIN=example.com
YANDEX_API_BASE_URL=https://botapi.messenger.yandex.net
YANDEX_AUTH_HEADER=Authorization
YANDEX_AUTH_SCHEME=OAuth

# Yandex Tracker (token and one organization ID are required when enabled)
ENABLE_YANDEX_TRACKER=false
YANDEX_TRACKER_API_BASE_URL=https://api.tracker.yandex.net
YANDEX_TRACKER_WEB_BASE_URL=https://tracker.yandex.ru
YANDEX_TRACKER_OAUTH_TOKEN=
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_CLOUD_ORG_ID=

# Tracker load protection: conservative starting settings, NOT confirmed API quotas.
# Shared per process. Includes every HTTP attempt/retry made by TrackerApiClient.
TRACKER_CONCURRENCY=4
TRACKER_MIN_INTERVAL_MS=150
TRACKER_MAX_QUEUE=200
TRACKER_QUEUE_TIMEOUT_MS=15000
TRACKER_REQUEST_TIMEOUT_MS=12000
TRACKER_OPERATION_TIMEOUT_MS=30000
TRACKER_MAX_RETRIES=2
# Interactive My day only; ACL-aware digest bypasses this cache. TTL 0 disables stored results.
MY_DAY_CACHE_TTL_MS=60000
MY_DAY_CACHE_MAX_ENTRIES=512
MY_DAY_MAX_PENDING=100
MY_DAY_LOAD_TIMEOUT_MS=45000

# Daily digest: Mon–Fri, 09:00–10:30 Europe/Moscow. OFF until an explicit pilot.
# Verified private contacts/preferences are recorded independently of ENABLE_ADMIN.
# Ubuntu: /var/lib/yassistant/digest.sqlite (different from analytics and short-links DBs).
ENABLE_DAILY_DIGEST=false
DIGEST_DB_PATH=./data/digest.sqlite
# Exact Messenger login(s), comma-separated. Empty forbids enabling scheduled sending.
# Use * ONLY after the pilot to include all verified subscribed contacts.
DIGEST_ALLOWLIST=
# One recipient at a time; minimum interval between starts, not an API quota.
DIGEST_MIN_INTERVAL_MS=10000
DIGEST_LOAD_TIMEOUT_MS=60000

# LLM (OPENROUTER_API_KEY is required when LLM_PROVIDER=openrouter)
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_HTTP_REFERER=https://assistant.example.com
OPENROUTER_X_TITLE=Yandex 360 AI Assistant
