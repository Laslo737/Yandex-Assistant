# Server
PORT=3002
NODE_ENV=production
APP_NAME=yandex-360-ai-assistant
APP_VERSION=0.1.0
# Public HTTPS URL served by nginx; no trailing slash.
APP_PUBLIC_BASE_URL=https://assistant.example.com
ENABLE_DEBUG_COMMANDS=false

# Yandex Messenger (required when ENABLE_YANDEX_MESSENGER=true)
ENABLE_YANDEX_MESSENGER=false
YANDEX_MESSENGER_KEY=
YANDEX_WEBHOOK_SECRET=
# For Messenger login name@company.tld -> Tracker login name; set to your organization domain.
YANDEX_MESSENGER_LOGIN_DOMAIN=example.com
YANDEX_API_BASE_URL=https://botapi.messenger.yandex.net
YANDEX_AUTH_HEADER=Authorization
YANDEX_AUTH_SCHEME=OAuth

# Yandex Tracker (token and one organization ID are required when enabled)
ENABLE_YANDEX_TRACKER=false
YANDEX_TRACKER_API_BASE_URL=https://api.tracker.yandex.net
YANDEX_TRACKER_WEB_BASE_URL=https://tracker.yandex.ru
YANDEX_TRACKER_OAUTH_TOKEN=
YANDEX_TRACKER_ORG_ID=
YANDEX_TRACKER_CLOUD_ORG_ID=

# LLM (OPENROUTER_API_KEY is required when LLM_PROVIDER=openrouter)
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_HTTP_REFERER=https://assistant.example.com
OPENROUTER_X_TITLE=Yandex 360 AI Assistant
