[Unit]
Description=Consistent Yassistant analytics backup and 14-day rotation

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/yassistant-analytics-backup
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yassistant /var/backups/yassistant /run/lock
